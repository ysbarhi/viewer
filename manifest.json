{
  "name": "Assembly Part Finder",
  "short_name": "APF",
  "id": "/viewer/",
  "description": "Assembly Part Finder (APF) : visionneuse 3D d'assemblage de meubles",
  "lang": "fr",
  "categories": ["productivity", "utilities"],
  "start_url": "/viewer/",
  "scope": "/viewer/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e5e5e5",
  "theme_color": "#2563eb",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared_file",
          "accept": [".glb", "model/gltf-binary", "application/octet-stream"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/gltf-binary": [".glb"],
        "application/octet-stream": [".glb"]
      }
    }
  ],
  "icons": [
    {
      "src": "logo-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "logo.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "logo-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
