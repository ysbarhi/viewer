{
  "name": "Viewer CAO",
  "short_name": "Viewer CAO",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#e5e5e5",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "logo.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared_file",
          "accept": [".glb", "model/gltf-binary"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "model/gltf-binary": [".glb"]
      }
    }
  ]
}
